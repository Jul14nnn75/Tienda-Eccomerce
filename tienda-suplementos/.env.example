# Copiá este archivo como ".env" y completá los valores del cliente.
#
# OJO: todo lo que empieza con VITE_ termina dentro del sitio público.
# Acá van solo claves públicas. El Access Token de Mercado Pago y la clave
# privada de Firebase NO van en este archivo: son secrets del Worker
# (ver README, paso 4).

# Firebase Console → Configuración del proyecto → Tus apps → Configuración del SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mercado Pago → Tus integraciones → tu app → Credenciales → Public Key
VITE_MP_PUBLIC_KEY=

# URL del Worker de pagos (la muestra "npm run deploy" en cloudflare-worker)
VITE_MP_CREATE_PREFERENCE_URL=https://NOMBRE-DEL-WORKER.SUBDOMINIO.workers.dev/
VITE_MP_PROCESS_PAYMENT_URL=https://NOMBRE-DEL-WORKER.SUBDOMINIO.workers.dev/process-payment
