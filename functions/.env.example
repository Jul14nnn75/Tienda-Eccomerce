# Copiá a functions/.env (se sube junto con el deploy; NO poner secretos acá).
# El Access Token va como secret: firebase functions:secrets:set MP_ACCESS_TOKEN
MP_CURRENCY_ID=ARS
MP_STATEMENT_DESCRIPTOR=MI TIENDA
# Dominios que pueden llamar a la función (separados por coma). Vacío = todos.
ALLOWED_ORIGINS=https://tu-sitio.netlify.app
# URL de mercadoPagoWebhook (se completa DESPUÉS del primer deploy — ver README).
MP_WEBHOOK_URL=
# Costo fijo de envío a domicilio, en la misma moneda que MP_CURRENCY_ID.
# Retiro en el local siempre es gratis. Tiene que coincidir con
# VITE_SHIPPING_COST en el .env del frontend (ese es solo el que se MUESTRA
# en el carrito antes de pagar; este es el que realmente se cobra).
MP_SHIPPING_COST=0
# Mail del dueño de la tienda para avisos de "nueva venta" y "reembolso".
# Vacío = no se manda nada.
ADMIN_NOTIFICATION_EMAIL=
# Remitente de los mails (aviso al dueño + confirmación de compra al
# comprador). El dominio de prueba de Resend (onboarding@resend.dev) funciona
# sin verificar nada, pero Resend a veces lo banea para producción real — para
# producción verificá tu propio dominio en resend.com y poné algo como
# "Mi Tienda <pedidos@tudominio.com>".
RESEND_FROM_EMAIL=onboarding@resend.dev
#
# RESEND_API_KEY — mail transaccional (mientras el proyecto esté en plan
# Spark/gratis, SIN Blaze):
# - NO va en este archivo (functions/.env se sube en cada deploy, y una key
#   acá quedaría en texto plano en la config de la función — nada de esto es
#   Secret Manager). Con RESEND_API_KEY sin setear, sendEmail() no manda
#   mails de verdad: loguea en las Functions logs (o la consola del
#   emulador) lo que hubiera mandado — sirve para probar todo el flujo de
#   checkout sin gastar en Blaze.
# - Si querés probar el envío REAL en tu máquina (emulador), creá
#   functions/.env.local (ya está en .gitignore, nunca se commitea NI se
#   sube en un deploy) y poné ahí: RESEND_API_KEY=re_tu_key_de_prueba
# - Para producción real, cuando se habilite el plan Blaze: alta gratis en
#   https://resend.com → API Keys → generar una → ver el bloque "ACTIVAR
#   RESEND EN PRODUCCIÓN" al principio de functions/index.js (son 3 pasos,
#   no hay que tocar el resto del código).
